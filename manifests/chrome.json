{
  "manifest_version": 3,
  "name": "Syncy",
  "version": "1.2.2",
  "description": "Sync bookmarks, history, tabs, tab groups and settings across browsers via WebDAV, Dropbox, GitHub, Google Drive or OneDrive.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "tabGroups", "bookmarks", "history", "alarms", "identity", "notifications", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Syncy", "default_popup": "popup/popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "options_page": "options/options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
